---
import NumberBlock from "./NumberBlock.astro";
import { address, email, routeUrl, mapEmbedUrl } from "../data/site";
---
<section id="contacts" class="contacts on-brand" data-rec="R-111,R-102,R-004">
  <div class="container">
    <h2 class="contacts__h2" data-reveal="wipe">{address.short}</h2>
    <p class="contacts__city lead">{address.postal}, {address.city}, {address.district}</p>

    <div class="contacts__actions">
      <a class="btn btn--outline btn--lg" href={routeUrl} target="_blank" rel="noopener">
        Маршрут
        <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 17L17 7M9 7h8v8" stroke="currentColor" stroke-width="2" fill="none"/></svg>
        <span class="visually-hidden">(Google Maps, нова вкладка)</span>
      </a>
      <a class="contacts__mail" href={`mailto:${email}`}>{email}</a>
    </div>

    <div class="contacts__numbers">
      <NumberBlock />
    </div>

    <div class="map" data-map={mapEmbedUrl}>
      <div class="map__ph">
        <p>Карта Google завантажиться лише після натискання.</p>
        <button class="btn btn--outline map__btn" type="button">Показати карту</button>
      </div>
    </div>
  </div>
</section>

<style>
  .contacts { padding-block: var(--section-y); }
  .contacts__h2 { font-size: var(--fs-statement); line-height: .95; font-weight: 800; letter-spacing: -0.035em; padding-bottom: .06em; }
  .contacts__city { margin-top: var(--s-2); color: var(--color-on-brand-muted); }
  .contacts__actions { display: flex; flex-wrap: wrap; align-items: center; gap: var(--s-2) var(--s-4); margin-top: var(--s-4); }
  .contacts__mail { display: inline-flex; align-items: center; min-height: var(--tap); font-size: var(--fs-lead); text-underline-offset: .2em; text-decoration-thickness: 1px; }
  .contacts__mail:hover { text-decoration-color: var(--color-accent); }
  .contacts__numbers { margin-top: var(--s-8); padding-top: var(--s-4); border-top: 1px solid var(--color-line-on-dark); }
  .map {
    margin-top: var(--s-8); aspect-ratio: 4 / 3; border-radius: var(--radius); overflow: hidden;
    background: var(--color-ink);
  }
  .map__ph { height: 100%; display: grid; place-content: center; justify-items: center; gap: var(--s-2); padding: var(--s-3); text-align: center; color: var(--color-on-brand-muted); }
  .map :global(iframe) { display: block; width: 100%; height: 100%; border: 0; }
  @media (min-width: 768px) { .map { aspect-ratio: 21 / 8; } }
</style>

<script>
  // The map iframe loads only on request (no third-party requests on page load).
  document.querySelectorAll<HTMLElement>("[data-map]").forEach((box) => {
    box.querySelector("button")?.addEventListener("click", () => {
      const f = document.createElement("iframe");
      f.src = box.dataset.map!;
      f.title = "Карта: вул. Електриків, 10, Київ";
      f.loading = "lazy";
      f.referrerPolicy = "no-referrer-when-downgrade";
      box.replaceChildren(f);
      f.focus();
    });
  });
</script>

---
import FutureLink from "./FutureLink.astro";
import { brand, phones, tail, address, futureNote } from "../data/site";
const nav = [
  { href: "#services", label: "Послуги" },
  { href: "#brands", label: "Марки" },
  { href: "#booking", label: "Запис" },
  { href: "#contacts", label: "Контакти" },
];
---
<header class="header on-brand" data-rec="R-113,R-114">
  <div class="container header__bar">
    <a class="wordmark" href="#top" aria-label={`${brand} — на початок сторінки`}>{brand}</a>

    <nav class="header__nav" aria-label="Розділи сторінки">
      <ul>
        {nav.map((n) => <li><a href={n.href}>{n.label}</a></li>)}
      </ul>
    </nav>

    <div class="header__actions">
      <button class="header__tel num" type="button" popovertarget="call-pop" data-rec="R-102">
        <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M6.6 10.8a15.2 15.2 0 0 0 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1A17 17 0 0 1 3 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.3 0 .7-.2 1z"/></svg>
        {tail}
      </button>
      <a class="btn btn--outline header__book" href="#booking">Записатися</a>
      <div class="lang" aria-label="Мова сайту">
        <span aria-current="true" lang="uk">УКР</span>
        <FutureLink note={futureNote} class="lang__ru"><span lang="ru">РУС</span></FutureLink>
      </div>

      <button class="header__call" type="button" popovertarget="call-pop" aria-label="Подзвонити">
        <svg width="22" height="22" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M6.6 10.8a15.2 15.2 0 0 0 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1A17 17 0 0 1 3 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.3 0 .7-.2 1z"/></svg>
      </button>
      <button class="header__burger" type="button" popovertarget="menu" aria-label="Меню">
        <svg width="22" height="22" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 7h18M3 12h18M3 17h18" stroke="currentColor" stroke-width="2"/></svg>
      </button>
    </div>
  </div>

  <div id="menu" class="menu on-ink" popover aria-label="Меню">
    <div class="menu__top">
      <span class="wordmark">{brand}</span>
      <button class="menu__close" type="button" popovertarget="menu" popovertargetaction="hide" aria-label="Закрити меню">
        <svg width="22" height="22" viewBox="0 0 20 20" aria-hidden="true"><path d="M4 4l12 12M16 4L4 16" stroke="currentColor" stroke-width="2"/></svg>
      </button>
    </div>
    <nav aria-label="Розділи сторінки (меню)">
      <ul class="menu__nav">
        {nav.map((n) => <li><a href={n.href}>{n.label}</a></li>)}
      </ul>
    </nav>
    <ul class="menu__phones" data-rec="R-102">
      {phones.map((p) => (
        <li><a class="menu__phone num" href={`tel:${p.tel}`}>{p.display}<span>{p.operator}</span></a></li>
      ))}
    </ul>
    <a class="menu__addr" href="#contacts">{address.street}, {address.district}</a>
  </div>
</header>

<style>
  .header {
    position: sticky; top: 0; z-index: 50;
    transition: background-color 240ms var(--ease-out);
  }
  .header.is-solid { background: var(--color-ink); }
  .header__bar { display: flex; align-items: center; gap: var(--s-3); height: var(--header-h); }
  .wordmark {
    font-family: var(--font-display); font-weight: 800; font-size: 1.375rem; letter-spacing: -0.03em;
    text-decoration: none; color: var(--color-on-brand); white-space: nowrap;
    min-height: var(--tap); display: inline-flex; align-items: center;
  }
  .header__nav { display: none; }
  .header__actions { margin-left: auto; display: flex; align-items: center; gap: var(--s-1); }
  .header__tel, .header__book, .lang { display: none; }

  .header__call, .header__burger {
    display: grid; place-items: center; width: var(--tap); height: var(--tap);
    border: 0; border-radius: 50%; cursor: pointer;
  }
  .header__call { background: var(--color-accent); color: var(--color-ink); }
  .header__call:active, .header__burger:active { transform: scale(.96); }
  .header__burger { background: transparent; color: var(--color-on-brand); border-radius: var(--radius); }
  .header__burger:hover { background: var(--color-hover-on-dark); }

  @media (min-width: 1024px) {
    .header__bar { gap: var(--s-4); }
    .header__nav { display: block; margin-left: var(--s-4); }
    .header__nav ul { display: flex; gap: var(--s-3); }
    .header__nav a {
      display: inline-flex; align-items: center; min-height: var(--tap);
      text-decoration: none; font-weight: 500; color: var(--color-on-brand);
      text-decoration: underline 2px transparent; text-underline-offset: 8px;
      transition: text-decoration-color var(--dur-fast) var(--ease-out);
    }
    .header__nav a:hover { text-decoration-color: currentColor; }
    .header__actions { gap: var(--s-3); }
    .header__tel {
      display: inline-flex; align-items: center; gap: var(--s-1); min-height: var(--tap); padding: 0 var(--s-1);
      background: none; border: 0; border-radius: var(--radius); cursor: pointer; color: var(--color-accent);
      font-family: var(--font-display); font-weight: 750; font-size: 1.25rem; letter-spacing: -0.01em;
    }
    .header__tel:hover { color: var(--color-on-brand); }
    .header__book { display: inline-flex; min-height: 44px; }
    .lang { display: flex; align-items: center; gap: var(--s-1); font-size: var(--fs-small); font-weight: 600; }
    .lang > span[aria-current] { color: var(--color-on-brand); }
    .lang :global(.lang__ru) { color: var(--color-on-brand-muted); }
    .lang :global(.lang__ru .future-link__note) { left: auto; right: 0; }
    .header__call, .header__burger { display: none; }
  }
  @media (min-width: 1024px) and (max-width: 1199px) {
    .lang { display: none; }
  }

  /* Mobile menu: native popover (Esc, tap outside), full-height sheet. */
  .menu {
    position: fixed; inset: 0; margin: 0; width: 100%; height: 100dvh; max-width: none; max-height: none;
    border: 0; padding: 0 var(--space) var(--s-4);
    overflow-y: auto;
    opacity: 0; transition: opacity var(--dur-fast) var(--ease-out), overlay var(--dur-fast) allow-discrete, display var(--dur-fast) allow-discrete;
  }
  .menu:popover-open { opacity: 1; display: flex; flex-direction: column; }
  @starting-style { .menu:popover-open { opacity: 0; } }
  .menu__top { display: flex; align-items: center; justify-content: space-between; height: var(--header-h); }
  .menu__close { display: grid; place-items: center; width: var(--tap); height: var(--tap); margin-right: -12px; background: none; border: 0; color: var(--color-on-brand); cursor: pointer; border-radius: var(--radius); }
  .menu__nav { margin-top: var(--s-3); }
  .menu__nav a {
    display: flex; align-items: center; min-height: 64px; border-bottom: var(--border) solid var(--color-line-on-dark);
    font-family: var(--font-display); font-weight: 750; font-size: 2rem; letter-spacing: var(--track-display); text-decoration: none;
  }
  .menu__phones { display: grid; gap: var(--s-1); margin-top: var(--s-4); }
  .menu__phone {
    display: flex; align-items: center; justify-content: space-between; min-height: 56px; padding: 0 var(--s-2);
    background: var(--color-accent); color: var(--color-ink); border-radius: var(--radius); text-decoration: none;
    font-family: var(--font-display); font-weight: 750; font-size: 1.125rem;
  }
  .menu__phone span { font-family: var(--font-body); font-weight: 500; font-size: var(--fs-small); }
  .menu__addr { display: inline-flex; align-items: center; min-height: var(--tap); margin-top: var(--s-3); color: var(--color-on-brand-muted); }
  @media (min-width: 1024px) { .menu { display: none !important; } }
</style>

<script>
  // Header turns ink once the blue hero is gone; the menu closes after an anchor is chosen.
  const header = document.querySelector<HTMLElement>(".header");
  const hero = document.getElementById("hero");
  if (header && hero && "IntersectionObserver" in window) {
    new IntersectionObserver(([e]) => header.classList.toggle("is-solid", !e.isIntersecting), {
      rootMargin: `-${header.offsetHeight}px 0px 0px 0px`,
    }).observe(hero);
  }
  const menu = document.getElementById("menu");
  menu?.querySelectorAll("a").forEach((a) => a.addEventListener("click", () => menu.hidePopover()));
</script>
